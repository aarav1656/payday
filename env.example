# Copy to .env (gitignored) and fill in. Never commit .env.
#   cp env.example .env && chmod 600 .env

# Binance Web3 API (signed calls under https://web3.binance.com/build)
# Create at https://web3.binance.com/en/dev-portal/project
# Tick the capability domains: Trading, Market, Wallet, Transaction.
# Used by src/exec/ and the web cash-out routes for quotes, Ondo RFQ orders and simulation.
BINANCE_W3_API_KEY=
BINANCE_W3_API_SECRET=

# Not needed here:
# - Public RWA data (token list, multipliers, prices, company names) needs no key.
# - Agentic Wallet: `baw` keeps its own session after you log in with a QR scan in the Binance App.
